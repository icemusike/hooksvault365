---
import AuthLayout from '../layouts/AuthLayout.astro';
import { DEMO_USER, SESSION_KEY } from '../utils/authUtils';
---

<AuthLayout title="Login - HookVault365">
	<div class="login-container">
		<div class="login-header">
			<h2>Welcome Back</h2>
			<p>Login to access your Hook Vault</p>
		</div>
		
		<div class="login-instructions">
			<i class="fas fa-info-circle"></i>
			<p>Enter your credentials below</p>
		</div>
		
		<!-- 
		<div class="social-login">
			<button type="button" class="social-btn google">
				<i class="fab fa-google"></i>
				<span>Continue with Google</span>
			</button>
			<button type="button" class="social-btn github">
				<i class="fab fa-github"></i>
				<span>Continue with GitHub</span>
			</button>
		</div>
		
		<div class="auth-separator">
			<span>Or login with email</span>
		</div>
		-->
		
		<form id="login-form" class="auth-form">
			<div class="form-group">
				<label for="email">Email</label>
				<div class="input-with-icon">
					<i class="fas fa-envelope"></i>
					<input 
						type="email" 
						id="email" 
						name="email" 
						placeholder="your@email.com" 
						required
					/>
				</div>
			</div>
			<div class="form-group">
				<label for="password">Password</label>
				<div class="input-with-icon password-input">
					<i class="fas fa-lock"></i>
					<input 
						type="password" 
						id="password" 
						name="password" 
						placeholder="Your password" 
						required
					/>
					<button type="button" id="toggle-password" aria-label="Toggle password visibility">
						<i class="fas fa-eye"></i>
					</button>
				</div>
				<div class="password-options">
					<div class="remember-me">
						<input type="checkbox" id="remember" name="remember">
						<label for="remember">Remember me</label>
					</div>
					<a href="#" class="forgot-password">Forgot password?</a>
				</div>
			</div>
			<div class="form-actions">
				<button type="submit" class="btn-primary">Sign In</button>
			</div>
			<div class="form-message" id="form-message"></div>
		</form>
		
		<div class="auth-separator">
			<span>Don't have an account?</span>
		</div>
		
		<div class="auth-links">
			<a href="/signup" class="btn-secondary">Create Account</a>
		</div>
		
		<div class="demo-credentials" id="demo-login">
			<div class="demo-header">
				<p>Try it with demo account:</p>
				<button class="demo-login-btn">
					<i class="fas fa-user-circle"></i>
					<span>Login as Demo</span>
				</button>
			</div>
			<div class="demo-info">
				<div class="demo-creds">
					<span><strong>Email:</strong> {DEMO_USER.email}</span>
					<span><strong>Password:</strong> {DEMO_USER.password}</span>
				</div>
			</div>
		</div>
	</div>
</AuthLayout>

<script>
	import { loginUser, getSession, SESSION_KEY } from '../utils/authUtils';

	// Function to display form messages
	const showMessage = (message, isError = false) => {
		const messageElement = document.getElementById('form-message');
		if (messageElement) {
			messageElement.textContent = message;
			messageElement.className = `form-message ${isError ? 'error' : 'success'}`;
			
			// Scroll to message
			messageElement.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		}
	};

	// Check if user is already logged in
	document.addEventListener('DOMContentLoaded', async () => {
		console.log('Login page loaded successfully');
		
		try {
			// Use the async getSession function
			const session = await getSession();
			console.log('Session check on login page:', session);
			
			// If already logged in, redirect to dashboard
			if (session && session.isLoggedIn) {
				console.log('User already logged in, redirecting to dashboard');
				window.location.replace('/dashboard');
			}
		} catch (error) {
			console.error('Error checking session:', error);
		}
	});

	// Handle form submission
	document.getElementById('login-form')?.addEventListener('submit', async (e) => {
		e.preventDefault();
		console.log('Login form submitted');
		
		const emailInput = document.getElementById('email');
		const passwordInput = document.getElementById('password');
		
		const email = emailInput?.value;
		const password = passwordInput?.value;
		
		if (!email || !password) {
			showMessage('Please enter both email and password', true);
			return;
		}
		
		// Disable the login button and show loading state
		const submitBtn = document.querySelector('.btn-primary');
		if (submitBtn) {
			submitBtn.setAttribute('disabled', 'true');
			submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Signing in...';
		}
		
		try {
			showMessage('Logging in...');
			console.log(`Attempting login with email: ${email}`);
			
			// Attempt to login
			const result = await loginUser(email, password);
			console.log('Login result:', result);
			
			if (result.success) {
				showMessage('Login successful! Redirecting...');
				
				// Wait a moment then redirect to dashboard
				setTimeout(() => {
					window.location.replace('/dashboard');
				}, 1000);
			} else {
				showMessage(result.message || 'Login failed', true);
				// Re-enable the login button
				if (submitBtn) {
					submitBtn.removeAttribute('disabled');
					submitBtn.innerHTML = 'Sign In';
				}
			}
		} catch (error) {
			console.error('Login error:', error);
			showMessage('An unexpected error occurred', true);
			// Re-enable the login button
			if (submitBtn) {
				submitBtn.removeAttribute('disabled');
				submitBtn.innerHTML = 'Sign In';
			}
		}
	});

	// Toggle password visibility
	document.getElementById('toggle-password')?.addEventListener('click', () => {
		const passwordInput = document.getElementById('password');
		const icon = document.querySelector('#toggle-password i');
		
		if (passwordInput && icon) {
			if (passwordInput.type === 'password') {
				passwordInput.type = 'text';
				icon.className = 'fas fa-eye-slash';
			} else {
				passwordInput.type = 'password';
				icon.className = 'fas fa-eye';
			}
		}
	});

	// Handle demo login button click
	document.querySelector('.demo-login-btn')?.addEventListener('click', async () => {
		// Fill in demo credentials
		const emailInput = document.getElementById('email');
		const passwordInput = document.getElementById('password');
		
		if (emailInput && passwordInput) {
			emailInput.value = 'demo@example.com';
			passwordInput.value = 'demo123';
			
			// Show message that we're logging in
			showMessage('Logging in with demo account...', false);
			
			// Submit the form programmatically
			const submitBtn = document.querySelector('.btn-primary');
			if (submitBtn) {
				submitBtn.setAttribute('disabled', 'true');
				submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Signing in...';
			}
			
			try {
				// Call login function directly instead of submitting the form
				const result = await loginUser('demo@example.com', 'demo123');
				
				if (result.success) {
					showMessage('Demo login successful! Redirecting...');
					
					// Wait a moment then redirect to dashboard
					setTimeout(() => {
						window.location.replace('/dashboard');
					}, 1000);
				} else {
					showMessage(result.message || 'Demo login failed', true);
					// Re-enable the login button
					if (submitBtn) {
						submitBtn.removeAttribute('disabled');
						submitBtn.innerHTML = 'Sign In';
					}
				}
			} catch (error) {
				console.error('Demo login error:', error);
				showMessage('An unexpected error occurred during demo login', true);
				// Re-enable the login button
				if (submitBtn) {
					submitBtn.removeAttribute('disabled');
					submitBtn.innerHTML = 'Sign In';
				}
			}
		}
	});
</script>

<style>
	.login-container {
		width: 100%;
		max-height: 100%;
		overflow-y: auto;
	}
	
	.login-header {
		text-align: center;
		margin-bottom: 1rem;
	}
	
	.login-header h2 {
		font-size: 1.8rem;
		font-weight: 700;
		margin-bottom: 0.25rem;
		color: var(--text-primary);
	}
	
	.login-header p {
		color: var(--text-secondary);
		font-size: 1rem;
	}
	
	.login-instructions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background-color: rgba(var(--accent), 0.1);
		border-left: 3px solid rgb(var(--accent));
		padding: 0.5rem 0.75rem;
		border-radius: 0.25rem;
		margin-bottom: 1rem;
	}
	
	.login-instructions i {
		color: rgb(var(--accent));
		font-size: 1.1rem;
	}
	
	.login-instructions p {
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.9rem;
		line-height: 1.4;
	}
	
	.social-login {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}
	
	.social-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		width: 100%;
		padding: 0.75rem;
		border-radius: 6px;
		border: 1px solid var(--border-color);
		background-color: transparent;
		color: var(--text-primary);
		font-size: 0.9rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s;
	}
	
	.social-btn:hover {
		background-color: var(--hover-bg);
	}
	
	.social-btn.google:hover {
		border-color: #4285F4;
		color: #4285F4;
	}
	
	.social-btn.github:hover {
		border-color: #333;
		color: #333;
	}
	
	.auth-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	
	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	
	.form-group label {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--text-secondary);
	}
	
	.input-with-icon {
		position: relative;
	}
	
	.input-with-icon i {
		position: absolute;
		left: 1rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-secondary);
	}
	
	.input-with-icon input {
		width: 100%;
		padding: 0.9rem 1rem 0.9rem 2.75rem;
		font-size: 1rem;
		border: 1px solid var(--border-color);
		border-radius: 6px;
		background-color: var(--input-bg);
		color: var(--text-primary);
		transition: all 0.2s;
	}
	
	.input-with-icon input:focus {
		border-color: rgb(var(--accent));
		box-shadow: 0 0 0 4px rgba(var(--accent), 0.2);
		outline: none;
		background-color: white;
	}
	
	.password-input button {
		position: absolute;
		right: 1rem;
		top: 50%;
		transform: translateY(-50%);
		background: none;
		border: none;
		color: var(--text-secondary);
		cursor: pointer;
		font-size: 1rem;
	}
	
	.password-input button:hover {
		color: rgb(var(--accent));
	}
	
	.password-options {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 0.75rem;
	}
	
	.remember-me {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	
	.remember-me label {
		font-size: 0.85rem;
		cursor: pointer;
	}
	
	.forgot-password {
		font-size: 0.85rem;
		color: rgb(var(--accent));
		text-decoration: none;
		font-weight: 500;
		transition: all 0.2s;
	}
	
	.forgot-password:hover {
		text-decoration: underline;
		color: rgb(var(--accent-dark));
	}
	
	.form-actions {
		margin-top: 1rem;
		animation: fadeInButton 0.5s ease-out forwards;
	}
	
	@keyframes fadeInButton {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	
	@keyframes buttonPulse {
		0% {
			box-shadow: 0 6px 15px rgba(var(--accent), 0.4);
		}
		50% {
			box-shadow: 0 6px 25px rgba(var(--accent), 0.65);
		}
		100% {
			box-shadow: 0 6px 15px rgba(var(--accent), 0.4);
		}
	}
	
	.btn-primary {
		width: 100%;
		padding: 0.75rem;
		font-size: 1rem;
		font-weight: 700;
		background-color: rgb(var(--accent));
		color: white;
		border: none;
		border-radius: 8px;
		cursor: pointer;
		transition: all 0.3s;
		box-shadow: 0 6px 15px rgba(var(--accent), 0.4);
		position: relative;
		overflow: hidden;
		letter-spacing: 0.5px;
		margin-top: 0.5rem;
		animation: buttonPulse 2s infinite ease-in-out;
	}
	
	.btn-primary:hover {
		background-color: rgb(var(--accent-dark));
		transform: translateY(-3px);
		box-shadow: 0 8px 20px rgba(var(--accent), 0.5);
	}
	
	.btn-primary:active {
		transform: translateY(-1px);
		box-shadow: 0 4px 10px rgba(var(--accent), 0.4);
	}
	
	.auth-separator {
		display: flex;
		align-items: center;
		margin: 1rem 0;
	}
	
	.auth-separator::before,
	.auth-separator::after {
		content: '';
		flex: 1;
		border-bottom: 1px solid var(--border-color);
	}
	
	.auth-separator span {
		padding: 0 1rem;
		font-size: 0.875rem;
		color: var(--text-secondary);
	}
	
	.auth-links {
		display: flex;
		justify-content: center;
	}
	
	.btn-secondary {
		display: inline-block;
		padding: 0.9rem 2rem;
		font-size: 1rem;
		font-weight: 500;
		text-align: center;
		background-color: transparent;
		color: rgb(var(--accent));
		border: 1px solid rgb(var(--accent));
		border-radius: 8px;
		cursor: pointer;
		transition: all 0.3s;
		text-decoration: none;
		box-shadow: 0 2px 6px rgba(var(--accent), 0.2);
	}
	
	.btn-secondary:hover {
		background-color: rgba(var(--accent), 0.1);
		transform: translateY(-2px);
		box-shadow: 0 4px 10px rgba(var(--accent), 0.25);
	}
	
	.btn-secondary:active {
		transform: translateY(0);
		box-shadow: 0 2px 5px rgba(var(--accent), 0.15);
	}
	
	.form-message {
		margin-top: 1rem;
		padding: 0.75rem;
		border-radius: 6px;
		font-size: 0.9rem;
		text-align: center;
	}
	
	.form-message.error {
		background-color: rgba(255, 0, 0, 0.1);
		color: #e53935;
		border: 1px solid rgba(229, 57, 53, 0.3);
	}
	
	.form-message.success {
		background-color: rgba(76, 175, 80, 0.1);
		color: #43a047;
		border: 1px solid rgba(67, 160, 71, 0.3);
	}
	
	.demo-credentials {
		margin-top: 0.75rem;
		padding: 0.75rem;
		background-color: rgba(var(--accent), 0.05);
		border-radius: 8px;
		font-size: 0.85rem;
		text-align: center;
		border: 1px dashed rgba(var(--accent), 0.3);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	
	.demo-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}
	
	.demo-header p {
		font-weight: 600;
		margin: 0;
		color: var(--text-primary);
		flex-shrink: 0;
	}
	
	.demo-login-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		flex-grow: 1;
		padding: 0.6rem;
		border-radius: 8px;
		background-color: rgb(var(--accent));
		color: white;
		border: none;
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.3s;
		box-shadow: 0 4px 8px rgba(var(--accent), 0.3);
	}
	
	.demo-login-btn:hover {
		background-color: rgb(var(--accent-dark));
		transform: translateY(-2px);
		box-shadow: 0 6px 12px rgba(var(--accent), 0.4);
	}
	
	.demo-login-btn:active {
		transform: translateY(0);
		box-shadow: 0 4px 6px rgba(var(--accent), 0.3);
	}
	
	.demo-info {
		font-size: 0.85rem;
	}
	
	.demo-creds {
		display: flex;
		justify-content: space-between;
		color: var(--text-primary);
	}
	
	.demo-creds span {
		font-family: monospace;
	}
</style> 