---
import Layout from '../layouts/Layout.astro';
import { getSession } from '../utils/authUtils';
import supabase from '../utils/supabaseClient';
---

<Layout title="HookVault365 - Settings" activeNav="settings">
  <div class="settings-container">
    
    <!-- Tab Navigation -->
    <div class="tabs-nav">
      <button class="tab-button active" data-tab="profile">Profile</button>
      <button class="tab-button" data-tab="integrations">Integrations</button>
      <button class="tab-button" data-tab="preferences">Preferences</button>
      <button class="tab-button" data-tab="data">Data Management</button>
    </div>

    <!-- Tab Content -->
    <div class="tabs-content">
      
      <!-- Profile Tab -->
      <div id="profile" class="tab-pane active">
        <div class="settings-section">
          <h2 class="section-title">User Profile</h2>
          <p class="section-description">View and update your profile information.</p>
          <div class="profile-form">
            <div class="form-group">
              <label for="profile-name">Full Name</label>
              <input type="text" id="profile-name" class="setting-input" readonly />
            </div>
            <div class="form-group">
              <label for="profile-email">Email</label>
              <input type="email" id="profile-email" class="setting-input" readonly />
            </div>
            <div class="form-group">
              <label>Password</label>
              <button id="change-password-btn" class="action-button">
                 <i class="fas fa-key"></i> Change Password
              </button>
              <p class="input-help">Click to update your password (functionality coming soon).</p>
            </div>
            <div class="form-actions">
              <button id="save-profile" class="save-button" disabled>
                <i class="fas fa-save"></i> Save Profile (Coming Soon)
              </button>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Integrations Tab -->
      <div id="integrations" class="tab-pane">
      <div class="settings-section">
        <h2 class="section-title">API Keys</h2>
        <p class="section-description">
            Configure API keys for external services integration. Validated keys are saved securely.
        </p>
        <div class="api-key-form">
          <div class="form-group">
            <label for="openai-api-key">OpenAI API Key</label>
            <div class="api-key-input">
                <input type="password" id="openai-api-key" placeholder="sk-..." class="setting-input"/>
                <button class="toggle-visibility" data-for="openai-api-key"><i class="fas fa-eye"></i></button>
            </div>
              <div id="openai-validation-status" class="validation-status"></div>
            <p class="input-help">Used for AI-generated hook suggestions and variations.</p>
          </div>
          
          <div class="form-group">
              <label for="openai-model">OpenAI Model</label>
              <div class="model-selection-container">
                <select id="openai-model" class="setting-input model-dropdown" disabled>
                  <option value="">Loading models...</option>
                </select>
                <button id="refresh-models" class="refresh-models-btn" title="Refresh available models">
                  <i class="fas fa-sync-alt"></i>
                </button>
              </div>
              <div id="model-info" class="model-info"></div>
              <p class="input-help">Select the AI model to use for generating hooks. More capable models may produce better results but can be more expensive.</p>
            </div>
            
            <div class="form-group">
              <label for="google-api-key">Google Sheets API Key (Coming Soon)</label>
            <div class="api-key-input">
                <input type="password" id="google-api-key" placeholder="AIza..." class="setting-input" disabled/>
                <button class="toggle-visibility" data-for="google-api-key" disabled><i class="fas fa-eye"></i></button>
              </div>
              <div id="google-validation-status" class="validation-status"></div>
              <p class="input-help">Used for syncing with private Google Sheets (feature coming soon).</p>
            </div>
            <div class="form-actions">
              <button id="save-api-keys" class="save-button">
                <i class="fas fa-save"></i> Save & Validate API Keys
              </button>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Preferences Tab -->
      <div id="preferences" class="tab-pane">
      <div class="settings-section">
        <h2 class="section-title">App Preferences</h2>
          <p class="section-description">Customize the application appearance and behavior.</p>
        <div class="form-group">
          <label>Theme</label>
          <div class="theme-selector">
            <label class="theme-option">
              <input type="radio" name="theme" value="light" checked />
                <span class="theme-preview light-theme"><i class="fas fa-sun"></i> Light</span>
            </label>
            <label class="theme-option">
              <input type="radio" name="theme" value="dark" />
                <span class="theme-preview dark-theme"><i class="fas fa-moon"></i> Dark</span>
            </label>
            <label class="theme-option">
              <input type="radio" name="theme" value="system" />
                <span class="theme-preview system-theme"><i class="fas fa-laptop"></i> System</span>
              </label>
            </div>
          </div>
          <div class="form-group save-theme-group">
            <label class="switch-label">
              <span>Remember theme preference</span>
              <div class="toggle-switch">
                <input type="checkbox" id="remember-theme" checked />
                <span class="toggle-slider"></span>
              </div>
            </label>
            <p class="input-help">If enabled, theme changes will be saved and applied across all pages even after you refresh.</p>
          </div>
        <div class="form-group">
            <label for="items-per-page">Items per page (Hook Vault)</label>
          <select id="items-per-page" class="setting-input">
            <option value="12">12</option>
            <option value="24" selected>24</option>
            <option value="36">36</option>
            <option value="48">48</option>
            <option value="60">60</option>
          </select>
        </div>
        <div class="form-actions">
          <button id="save-preferences" class="save-button">
            <i class="fas fa-save"></i> Save Preferences
          </button>
          </div>
        </div>
      </div>
      
      <!-- Data Management Tab -->
      <div id="data" class="tab-pane">
      <div class="settings-section">
        <h2 class="section-title">Data Management</h2>
          <p class="section-description">Manage your saved hooks, favorites, and application data.</p>
        <div class="data-actions">
          <button id="clear-favorites" class="action-button danger">
            <i class="fas fa-trash"></i> Clear Favorites
          </button>
          <button id="reset-settings" class="action-button warning">
            <i class="fas fa-exclamation-triangle"></i> Reset Settings
          </button>
            <button class="action-button import" disabled>
              <i class="fas fa-file-import"></i> Import Data (Soon)
          </button>
            <button class="action-button export" disabled>
              <i class="fas fa-file-export"></i> Export Data (Soon)
          </button>
        </div>
      </div>
    </div>
      
    </div> <!-- End Tabs Content -->
    
  </div> <!-- End Settings Container -->
  
  <!-- Custom Confirmation Modal -->
  <div id="confirmation-modal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="modal-title">Confirmation</h3>
        <button class="modal-close" id="modal-close">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="modal-body">
        <p id="modal-message">Are you sure you want to proceed?</p>
      </div>
      <div class="modal-footer">
        <button id="modal-cancel" class="modal-button cancel">Cancel</button>
        <button id="modal-confirm" class="modal-button confirm">Confirm</button>
      </div>
    </div>
  </div>
</Layout>

<style>
  .settings-container {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .settings-panel {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  
  .settings-section {
    background: var(--bg-secondary);
    border-radius: 0.75rem;
    box-shadow: var(--card-shadow);
    padding: 1.5rem;
    border: 1px solid var(--border-color);
  }
  
  .section-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  
  .section-description {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  
  .form-group {
    margin-bottom: 1.5rem;
  }
  
  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--text-primary);
  }
  
  .setting-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    font-size: 0.9rem;
    transition: all 0.3s;
    background: var(--input-bg);
    color: var(--text-primary);
  }
  
  .setting-input:focus {
    outline: none;
    border-color: rgb(var(--accent));
    box-shadow: 0 0 0 3px rgba(var(--accent), 0.2);
  }
  
  .api-key-input {
    position: relative;
    display: flex;
  }
  
  .toggle-visibility {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    font-size: 1rem;
    padding: 0.25rem;
    transition: all 0.2s;
  }
  
  .toggle-visibility:hover {
    color: rgb(var(--accent));
  }
  
  .input-help {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  
  .form-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 1rem;
  }
  
  .save-button {
    background-color: rgb(var(--accent));
    color: white;
    border: none;
    border-radius: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-weight: 500;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .save-button:hover {
    background-color: rgb(var(--accent-dark));
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(var(--accent), 0.3);
  }
  
  .theme-selector {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  
  .theme-option {
    flex: 1;
    cursor: pointer;
  }
  
  .theme-option input {
    display: none;
  }
  
  .theme-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem;
    border-radius: 0.5rem;
    border: 2px solid var(--border-color);
    transition: all 0.2s;
    gap: 0.5rem;
  }
  
  .theme-preview i {
    font-size: 1.5rem;
  }
  
  .theme-option input:checked + .theme-preview {
    border-color: rgb(var(--accent));
    background-color: rgba(var(--accent), 0.1);
    color: rgb(var(--accent));
  }
  
  .light-theme {
    background: #ffffff;
    color: #333;
  }
  
  .dark-theme {
    background: #1e293b;
    color: #f9fafb;
  }
  
  .system-theme {
    background: linear-gradient(to right, #ffffff 50%, #1e293b 50%);
    color: #333;
  }
  
  .data-actions {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }
  
  .action-button {
    padding: 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border-color);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  
  .action-button i {
    font-size: 1.25rem;
  }
  
  .action-button:hover {
    transform: translateY(-3px);
    box-shadow: var(--card-shadow);
  }
  
  .action-button.danger {
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.2);
  }
  
  .action-button.danger:hover {
    background: rgba(239, 68, 68, 0.1);
  }
  
  .action-button.warning {
    color: #f59e0b;
    border-color: rgba(245, 158, 11, 0.2);
  }
  
  .action-button.warning:hover {
    background: rgba(245, 158, 11, 0.1);
  }
  
  .action-button.import {
    color: #3b82f6;
    border-color: rgba(59, 130, 246, 0.2);
  }
  
  .action-button.import:hover {
    background: rgba(59, 130, 246, 0.1);
  }
  
  .action-button.export {
    color: #10b981;
    border-color: rgba(16, 185, 129, 0.2);
  }
  
  .action-button.export:hover {
    background: rgba(16, 185, 129, 0.1);
  }
  
  /* Modal Styles */
  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }
  
  .modal.active {
    display: flex;
    animation: fadeIn 0.3s ease-out;
  }
  
  .modal-content {
    background: var(--bg-secondary);
    border-radius: 0.75rem;
    box-shadow: var(--card-shadow);
    width: 90%;
    max-width: 450px;
    overflow: hidden;
    animation: scaleIn 0.3s ease-out;
  }
  
  .modal-header {
    padding: 1.25rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .modal-header h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }
  
  .modal-close {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 1.1rem;
    cursor: pointer;
    opacity: 0.7;
    transition: all 0.2s;
    padding: 0.25rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
  }
  
  .modal-close:hover {
    opacity: 1;
    background-color: rgba(var(--accent-light), 0.1);
    color: rgb(var(--accent));
  }
  
  .modal-body {
    padding: 1.5rem;
    color: var(--text-primary);
  }
  
  .modal-footer {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
  }
  
  .modal-button {
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .modal-button.cancel {
    background: var(--bg-primary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }
  
  .modal-button.cancel:hover {
    background: var(--border-color);
  }
  
  .modal-button.confirm {
    background: rgb(var(--accent));
    color: white;
    border: none;
  }
  
  .modal-button.confirm:hover {
    background: rgb(var(--accent-dark));
    transform: translateY(-2px);
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes scaleIn {
    from { transform: scale(0.95); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  
  @media (max-width: 768px) {
    .theme-selector {
      flex-direction: column;
    }
    
    .data-actions {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Add Tab Styles */
  .tabs-nav {
    display: flex;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .tab-button {
    padding: 0.75rem 1.25rem;
    cursor: pointer;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    color: var(--text-secondary);
    font-weight: 500;
    transition: all 0.2s ease;
    margin-bottom: -1px; /* Overlap border */
  }

  .tab-button:hover {
    color: var(--text-primary);
  }

  .tab-button.active {
    color: rgb(var(--accent));
    border-bottom-color: rgb(var(--accent));
  }

  .tab-pane {
    display: none; /* Hide inactive tabs by default */
  }

  .tab-pane.active {
    display: block; /* Show active tab */
    animation: fadeIn 0.5s ease; /* Add fade-in animation */
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Toggle Switch Styles */
  .switch-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    color: var(--text-primary);
    font-weight: 500;
  }
  
  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 52px;
    height: 26px;
  }
  
  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  
  .toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #ccc;
    transition: .4s;
    border-radius: 34px;
  }
  
  .toggle-slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 4px;
    bottom: 4px;
    background-color: white;
    transition: .4s;
    border-radius: 50%;
  }
  
  input:checked + .toggle-slider {
    background-color: rgb(var(--accent));
  }
  
  input:checked + .toggle-slider:before {
    transform: translateX(26px);
  }
  
  .save-theme-group {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
  }

  .validation-status {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    min-height: 1.2em; /* Reserve space to prevent layout shifts */
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .validation-status.loading {
    color: var(--text-secondary);
  }
  
  .validation-status.success {
    color: var(--success);
    font-weight: 500;
  }
  
  .validation-status.error {
    color: var(--error);
    font-weight: 500;
  }

  .model-selection-container {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  
  .model-dropdown {
    flex: 1;
  }
  
  .refresh-models-btn {
    background: none;
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .refresh-models-btn:hover {
    background: var(--bg-primary);
    color: rgb(var(--accent));
    border-color: rgb(var(--accent));
  }
  
  .refresh-models-btn i.fa-spin {
    animation: spin 1s linear infinite;
  }
  
  .model-info {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

<script>
  import { showSuccess, showError, showWarning } from '../utils/notificationUtils';
  import { setTheme } from '../utils/themeUtils';
  import { getSession } from '../utils/authUtils';
  import supabase from '../utils/supabaseClient';

  document.addEventListener('DOMContentLoaded', async () => {
    console.log('Settings page loaded');
    
    // Variables for modal functionality
    let currentAction = null;
    let currentActionConfirmCallback = null;

    // Tab Functionality
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabPanes = document.querySelectorAll('.tab-pane');
    
    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tabId = button.getAttribute('data-tab');
        
        // Remove active class from all buttons
        tabButtons.forEach(btn => btn.classList.remove('active'));
        // Add active class to current button
        button.classList.add('active');
        
        // Hide all tab panes
        tabPanes.forEach(pane => pane.classList.remove('active'));
        // Show the selected tab pane
        document.getElementById(tabId).classList.add('active');
      });
    });

    // Load profile data
    try {
      // Use the async getSession function
      const session = await getSession();
      console.log('Loading profile from session:', session);
      
      if (session) {
        // Set user profile information
        const nameInput = document.getElementById('profile-name');
        const emailInput = document.getElementById('profile-email');
        
        if (nameInput && emailInput) {
          // If we have a display name, use that; otherwise, extract username from email
          const displayName = session.displayName || (session.email ? session.email.split('@')[0] : '');
          nameInput.value = displayName;
          emailInput.value = session.email || '';
        }
      } else {
        console.warn('Could not load user session data for profile');
      }
    } catch (error) {
      console.error('Error loading profile:', error);
    }

    // API Key Management
    const openaiKeyInput = document.getElementById('openai-api-key');
    const openaiValidationStatus = document.getElementById('openai-validation-status');
    const googleKeyInput = document.getElementById('google-api-key');
    const googleValidationStatus = document.getElementById('google-validation-status');
    const saveApiKeysBtn = document.getElementById('save-api-keys');
    
    // Toggle password visibility
  document.querySelectorAll('.toggle-visibility').forEach(button => {
    button.addEventListener('click', () => {
      const inputId = button.getAttribute('data-for');
      const input = document.getElementById(inputId);
        const icon = button.querySelector('i');
      
      if (input.type === 'password') {
        input.type = 'text';
          icon.className = 'fas fa-eye-slash';
      } else {
        input.type = 'password';
          icon.className = 'fas fa-eye';
      }
    });
  });

    // OpenAI Model Selection
    const modelDropdown = document.getElementById('openai-model');
    const refreshModelsBtn = document.getElementById('refresh-models');
    const modelInfo = document.getElementById('model-info');
    let openAIModels = null;
    
    // Load saved OpenAI model preference
    const savedModel = localStorage.getItem('openai_model');
    
    // Function to load OpenAI models
    async function loadOpenAIModels() {
      // Check if we have an API key
      const apiKey = openaiKeyInput.value.trim() || localStorage.getItem('openai_api_key');
      
      if (!apiKey) {
        modelDropdown.innerHTML = '<option value="">API Key Required</option>';
        modelDropdown.disabled = true;
        modelInfo.textContent = 'Please enter and save your OpenAI API key first.';
        return;
      }
      
      try {
        // Show loading state
        refreshModelsBtn.querySelector('i').classList.add('fa-spin');
        modelDropdown.disabled = true;
        modelDropdown.innerHTML = '<option value="">Loading models...</option>';
        modelInfo.textContent = 'Fetching available models...';
        
        // Fetch models from our API
        const response = await fetch('/api/list-openai-models', {
          method: 'GET',
          headers: {
            'x-openai-key': apiKey
          }
        });
        
        const data = await response.json();
        
        if (data.error) {
          throw new Error(data.error);
        }
        
        openAIModels = data.models;
        
        // Populate dropdown with models
        let optionsHTML = '';
        
        // Add recommended models group
        optionsHTML += '<optgroup label="Recommended Models">';
        openAIModels.recommended.forEach(modelId => {
          optionsHTML += `<option value="${modelId}" ${savedModel === modelId ? 'selected' : ''}>${modelId}</option>`;
        });
        optionsHTML += '</optgroup>';
        
        // Add GPT-3.5 models group
        optionsHTML += '<optgroup label="GPT-3.5 Models">';
        openAIModels.gpt35.forEach(model => {
          // Skip if already in recommended
          if (!openAIModels.recommended.includes(model.id)) {
            optionsHTML += `<option value="${model.id}" ${savedModel === model.id ? 'selected' : ''}>${model.id}</option>`;
          }
        });
        optionsHTML += '</optgroup>';
        
        // Add GPT-4 models group
        optionsHTML += '<optgroup label="GPT-4 Models">';
        openAIModels.gpt4.forEach(model => {
          // Skip if already in recommended
          if (!openAIModels.recommended.includes(model.id)) {
            optionsHTML += `<option value="${model.id}" ${savedModel === model.id ? 'selected' : ''}>${model.id}</option>`;
          }
        });
        optionsHTML += '</optgroup>';
        
        modelDropdown.innerHTML = optionsHTML;
        modelDropdown.disabled = false;
        
        // If no saved model but we have models, select first recommended
        if (!savedModel && openAIModels.recommended.length > 0) {
          modelDropdown.value = openAIModels.recommended[0];
        }
        
        updateModelInfo();
        
      } catch (error) {
        console.error('Error loading OpenAI models:', error);
        modelDropdown.innerHTML = '<option value="">Error loading models</option>';
        modelInfo.textContent = `Error: ${error.message}`;
      } finally {
        // Remove loading state
        refreshModelsBtn.querySelector('i').classList.remove('fa-spin');
      }
    }
    
    // Update model info based on selection
    function updateModelInfo() {
      const selectedModel = modelDropdown.value;
      
      if (selectedModel.includes('gpt-4')) {
        modelInfo.textContent = 'GPT-4 models are more capable but more expensive. Check your OpenAI account for pricing.';
      } else if (selectedModel.includes('gpt-3.5')) {
        modelInfo.textContent = 'GPT-3.5 models offer a good balance between capability and cost.';
      } else {
        modelInfo.textContent = '';
      }
    }
    
    // Listen for model selection changes
    modelDropdown.addEventListener('change', () => {
      updateModelInfo();
    });
    
    // Refresh models button
    refreshModelsBtn.addEventListener('click', loadOpenAIModels);
    
    // Previous code for Save API Keys
    saveApiKeysBtn.addEventListener('click', async () => {
      console.log('Save API keys button clicked');
      
      const openaiKey = openaiKeyInput.value.trim();
      const googleKey = googleKeyInput.value.trim();
      
      // Update UI to show validation in progress
      if (openaiKey) {
        openaiValidationStatus.textContent = 'Validating...';
        openaiValidationStatus.className = 'validation-status validating';
        
        try {
          // Validate OpenAI key by trying to list models
          const response = await fetch('/api/list-openai-models', {
            method: 'GET',
            headers: {
              'x-openai-key': openaiKey
            }
          });
          
          const data = await response.json();
          
          if (data.error) {
            throw new Error(data.error);
          }
          
          // Key is valid
          openaiValidationStatus.textContent = 'API key valid!';
          openaiValidationStatus.className = 'validation-status valid';
          
          // Save to localStorage
          localStorage.setItem('openai_api_key', openaiKey);
          
          // Fetch and populate models
          await loadOpenAIModels();
          
        } catch (error) {
          console.error('OpenAI API key validation error:', error);
          openaiValidationStatus.textContent = `Invalid: ${error.message}`;
          openaiValidationStatus.className = 'validation-status invalid';
        }
      } else {
        // Clear validation status if empty
        openaiValidationStatus.textContent = '';
        openaiValidationStatus.className = 'validation-status';
        
        // Remove from localStorage if existed
        if (localStorage.getItem('openai_api_key')) {
          localStorage.removeItem('openai_api_key');
        }
      }
      
      // Google validation would go here when implemented
      
      // Show success message
      showToast('API settings saved successfully!');
    });
    
    // Save the selected OpenAI model
    async function saveSelectedModel() {
      const selectedModel = modelDropdown.value;
      
      if (selectedModel) {
        localStorage.setItem('openai_model', selectedModel);
        showToast('AI model preference saved!');
      }
    }
    
    // Add event listener to save model when changed
    modelDropdown.addEventListener('change', saveSelectedModel);
    
    // Load saved OpenAI API key and init model dropdown
    const savedOpenAIKey = localStorage.getItem('openai_api_key');
    if (savedOpenAIKey) {
      openaiKeyInput.value = savedOpenAIKey;
      loadOpenAIModels();
    }

    // Other existing code for preferences, theme selection, etc.
    
    // ... existing code ...
  });
</script> 