<script>
	import { initializeTheme } from '../utils/themeUtils';
	import { getSession, SESSION_KEY } from '../utils/authUtils';
	
	// Initialize theme on page load
	document.addEventListener('DOMContentLoaded', () => {
		initializeTheme();
		
		// Check if user is already authenticated, if so redirect to dashboard
		setTimeout(() => {
			const session = getSession();
			console.log('Landing page auth check:', {
				session,
				sessionString: localStorage.getItem(SESSION_KEY)
			});
			
			if (session && session.isLoggedIn) {
				console.log('User already authenticated, redirecting to dashboard');
				
				try {
					// Use location.replace for a clean redirect without browser history
					window.location.replace('/dashboard');
				} catch (err) {
					console.error('Error redirecting to dashboard:', err);
					
					// Fallback method if replace fails
					window.location.href = '/dashboard';
				}
			} else {
				console.log('User not authenticated, staying on landing page');
			}
		}, 500); // Allow more time for session to load
		
		// FAQ toggle functionality
		const faqToggles = document.querySelectorAll('.faq-toggle');
		faqToggles.forEach(toggle => {
			toggle.addEventListener('click', () => {
				const faqItem = toggle.closest('.faq-item');
				faqItem.classList.toggle('active');
				
				const icon = toggle.querySelector('i');
				icon.className = faqItem.classList.contains('active') ? 'fas fa-minus' : 'fas fa-plus';
			});
		});
		
		// FAQ toggle functionality (alternative implementation)
		const faqItems = document.querySelectorAll('.faq-item');
		faqItems.forEach(item => {
			const question = item.querySelector('.faq-question');
			
			question.addEventListener('click', () => {
				item.classList.toggle('active');
			});
		});
	});
</script>

<style>
	/* Brand Colors */
	:root {
		--primary: #FF0000; /* YouTube Red */
		--secondary: #009688; /* HookVault Teal */
		--accent: #00E5FF; /* Aqua Glow */
		--gray-100: #F8F9FA;
		--gray-200: #E9ECEF;
		--gray-300: #DEE2E6;
		--gray-400: #CED4DA;
		--gray-500: #ADB5BD;
		--gray-600: #6C757D;
		--gray-700: #495057;
		--gray-800: #343A40;
		--gray-900: #212529;
		--white: #FFFFFF;
		--black: #000000;
	}

	/* General Styles */
	.landing-page {
		font-family: 'Inter', sans-serif;
		color: var(--gray-800);
		line-height: 1.6;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
	}

	section {
		padding: 80px 0;
	}

	h1, h2, h3, h4, h5, h6 {
		font-weight: 700;
		line-height: 1.2;
	}

	h1 {
		font-size: 3.5rem;
		margin-bottom: 1.5rem;
		color: #ffffff;
		line-height: 1.2;
		text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
		font-weight: 800;
		letter-spacing: -0.5px;
	}

	h2 {
		font-size: 2.5rem;
		margin-bottom: 3rem;
		text-align: center;
	}

	.highlight {
		color: var(--primary);
	}

	/* Buttons */
	.cta-button {
		display: inline-block;
		background: var(--primary);
		color: var(--white);
		padding: 12px 28px;
		border-radius: 30px;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.3s ease;
		border: 2px solid var(--primary);
	}

	.cta-button:hover {
		background: #e60000;
		border-color: #e60000;
		transform: translateY(-2px);
		box-shadow: 0 10px 20px rgba(255, 0, 0, 0.2);
	}

	.secondary-button {
		display: inline-block;
		background: transparent;
		color: var(--primary);
		padding: 12px 28px;
		border-radius: 30px;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.3s ease;
		border: 2px solid var(--primary);
	}

	.secondary-button:hover {
		background: rgba(255, 0, 0, 0.05);
		transform: translateY(-2px);
	}

	/* Hero Section - Dark Design */
	.hero-section {
		background: linear-gradient(125deg, #121212 0%, #232323 75%, #2a2a2a 100%);
		position: relative;
		overflow: hidden;
		padding-top: 100px;
		padding-bottom: 100px;
		color: #ffffff;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
	}

	.hero-section::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
		opacity: 0.4;
	}

	.hero-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.hero-content {
		max-width: 580px;
		padding: 0;
		position: relative;
		z-index: 2;
	}

	.hero-section h1 {
		font-size: 4rem;
		margin-bottom: 1.5rem;
		color: #ffffff;
		line-height: 1.15;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
		font-weight: 800;
		letter-spacing: -0.5px;
	}

	.hero-section .highlight {
